# Your org's address. Must start with https://
OKTA_ORG_URL=https://your-org.okta.com
# Token of a read-only admin. Never commit the real value.
OKTA_API_TOKEN=REPLACE_WITH_OKTA_API_TOKEN
# true serves labelled sample data and ignores the two values above.
# With false, a missing token or URL is an error, not a switch to sample data.
DEMO_MODE=false
